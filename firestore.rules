rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userEmail
    // Fields:
    //   - email: string (required)
    //   - role: string (required, 'admin' or 'editor')
    //
    // Collection: chapters
    // Document ID: chapterId
    // Fields:
    //   - id: string
    //   - title: string
    //   - ... (other fields from types.ts)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRoster() {
      return exists(/databases/$(database)/documents/teamState/roster);
    }

    function isLegacyAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    function isAdmin() {
      return (!hasRoster() && isLegacyAdmin()) || (hasRoster() && isLegacyAdmin() &&
        get(/databases/$(database)/documents/teamState/roster).data.members.hasAny([request.auth.token.email]));
    }

    function isMember() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['admin', 'editor', 'viewer'] &&
        (!hasRoster() ? isLegacyAdmin() : get(/databases/$(database)/documents/teamState/roster).data.members.hasAny([request.auth.token.email]));
    }

    function canEdit() {
      return isMember() &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['admin', 'editor'];
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['email', 'role']) &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             data.role in ['admin', 'editor', 'viewer'];
    }

    function isSafeReference(value) {
      return value is string &&
        (value == '' || value.matches('^https://[^\\s]+$') ||
          (value.matches('^[^/\\\\:]+(/[^/\\\\:]+)*$') && !value.matches('(^|.*/)\\.\\.(/.*|$)')));
    }

    function isValidChapter(data) {
      return data.keys().hasOnly(['id', 'contributorId', 'contributorName', 'contributorEmail', 'title', 'folderUrl', 'leadEditor', 'initialAbstractSubmitted', 'updatedAbstractSubmitted', 'updatedAbstractDate', 'abstractRevision', 'initialChapterSubmission', 'initialChapterDate', 'chapterRevision', 'submittedWordCount', 'followUpForInitialSubmission', 'followUpDate', 'feedbackSent', 'dateFeedbackSent', 'feedbackReceived', 'dateFeedbackReceived', 'feedbackLink', 'feedbackRevision', 'revision01Submitted', 'dateRevision01Submitted', 'manuscriptSubmission', 'manuscriptSubmissionDate', 'publisherSubmission', 'publisherSubmissionDate', 'typesetSubmission', 'typesetSubmissionDate', 'biographicalStatement', 'bioText', 'abstractText', 'institutionalAffiliation', 'contactPerson', 'followUpContacted', 'dateFollowUpContacted', 'decisionToProceed', 'reasonIfNo', 'imageListSubmitted', 'imagesMeetQc', 'indexingTermsSubmitted', 'dataRevision', 'updatedAt', 'updatedBy', 'submissions']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.title is string && data.title.size() >= 0 && data.title.size() < 500 &&
             (!('folderUrl' in data) || isSafeReference(data.folderUrl)) &&
             (!('feedbackLink' in data) || isSafeReference(data.feedbackLink)) &&
             (!('submissions' in data) || (data.submissions is list && data.submissions.size() <= 100));
    }

    function isValidTeamState(data) {
      return data.keys().hasOnly(['members', 'updatedAt']) &&
        data.members is list && data.members.size() <= 5 &&
        data.updatedAt is string;
    }

    function isValidProject(data) {
      return data.keys().hasOnly(['name', 'generationId', 'startedAt', 'startedBy', 'updatedAt']) &&
        data.name is string &&
        data.name.size() >= 1 && data.name.size() <= 120 &&
        data.generationId is string &&
        data.generationId.size() >= 1 && data.generationId.size() <= 100 &&
        data.generationId.matches('^[A-Za-z0-9._-]+$') &&
        data.startedAt is string && data.startedAt.matches('^\\d{4}-\\d{2}-\\d{2}T.*Z$') &&
        data.startedBy is string && data.startedBy.size() > 0 && data.startedBy.size() <= 120 &&
        data.updatedAt is string && data.updatedAt.matches('^\\d{4}-\\d{2}-\\d{2}T.*Z$');
    }

    function isValidActivity(data) {
      return data.keys().hasOnly(['actorEmail', 'action', 'summary', 'chapterId', 'chapterIds', 'changedFields', 'revisionBefore', 'revisionAfter', 'counts', 'clientAt', 'serverAt']) &&
        data.actorEmail == request.auth.token.email &&
        data.action in ['chapter-created', 'chapter-updated', 'chapter-deleted', 'batch-status-updated', 'chapter-imported', 'project-history-imported', 'stage-record-added', 'stage-record-voided', 'team-changed', 'project-started'] &&
        data.summary is string && data.summary.size() > 0 && data.summary.size() <= 300 &&
        !data.summary.matches('.*file:.*') && !data.summary.matches('.*[A-Za-z]:/.*') && !data.summary.matches('.*\\\\.*') &&
        data.clientAt is string && data.clientAt.matches('^\\d{4}-\\d{2}-\\d{2}T.*Z$') &&
        (!('serverAt' in data) || data.serverAt is timestamp) &&
        (!('chapterId' in data) || (data.chapterId is string && data.chapterId.size() > 0 && data.chapterId.size() < 100)) &&
        (!('chapterIds' in data) || (data.chapterIds is list && data.chapterIds.size() > 0 && data.chapterIds.size() <= 50)) &&
        (!('changedFields' in data) || (data.changedFields is list && data.changedFields.size() <= 50)) &&
        (!('revisionBefore' in data) || data.revisionBefore is int) &&
        (!('revisionAfter' in data) || data.revisionAfter is int) &&
        (!('counts' in data) || (data.counts is map && data.counts.keys().size() <= 50));
    }

    match /teamState/{stateId} {
      allow get: if isMember() && (stateId == 'roster' || stateId == 'project');
      allow list: if false;
      allow create: if (stateId == 'roster' && isValidTeamState(request.resource.data) && request.resource.data.members.hasAny([request.auth.token.email]) && isAdmin())
                    || (stateId == 'project' && isAdmin() && isValidProject(request.resource.data));
      allow update: if (stateId == 'roster' && isAdmin() && isValidTeamState(request.resource.data))
                    || (stateId == 'project' && isAdmin() && isValidProject(request.resource.data));
      allow delete: if false;
    }

    match /users/{userEmail} {
      allow get: if isMember() || (isAuthenticated() && userEmail == request.auth.token.email);
      allow list: if isMember();
      allow create: if isAdmin() && isValidUser(request.resource.data) && userEmail == request.resource.data.email &&
        existsAfter(/databases/$(database)/documents/teamState/roster) &&
        getAfter(/databases/$(database)/documents/teamState/roster).data.members.hasAny([userEmail]);
      allow update: if isAdmin() && isValidUser(request.resource.data) && userEmail == request.resource.data.email &&
        existsAfter(/databases/$(database)/documents/teamState/roster) &&
        getAfter(/databases/$(database)/documents/teamState/roster).data.members.hasAny([userEmail]);
      allow delete: if isAdmin() && existsAfter(/databases/$(database)/documents/teamState/roster) &&
        !getAfter(/databases/$(database)/documents/teamState/roster).data.members.hasAny([userEmail]);
    }

    match /chapters/{chapterId} {
      allow read: if isMember();
      allow create: if canEdit() && chapterId == request.resource.data.id && isValidChapter(request.resource.data);
      allow update: if canEdit() && chapterId == request.resource.data.id && isValidChapter(request.resource.data);
      allow delete: if isAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isMember();
      allow create: if canEdit() && isValidActivity(request.resource.data) &&
        (request.resource.data.action != 'team-changed' || isAdmin()) &&
        (request.resource.data.action != 'project-started' || isAdmin());
      allow update, delete: if false;
    }
  }
}
