{
  "entities": {
    "Chapter": {
      "title": "Chapter",
      "description": "Represents a chapter in the editing tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contributorId": { "type": "string" },
        "contributorName": { "type": "string" },
        "contributorEmail": { "type": "string" },
        "title": { "type": "string" },
        "folderUrl": { "type": "string" },
        "leadEditor": { "type": "string" },
        "initialAbstractSubmitted": { "type": "string" },
        "updatedAbstractSubmitted": { "type": "string" },
        "updatedAbstractDate": { "type": "string" },
        "abstractRevision": { "type": "string" },
        "initialChapterSubmission": { "type": "string" },
        "initialChapterDate": { "type": "string" },
        "chapterRevision": { "type": "string" },
        "submittedWordCount": { "type": "string" },
        "followUpForInitialSubmission": { "type": "string" },
        "followUpDate": { "type": "string" },
        "feedbackSent": { "type": "string" },
        "dateFeedbackSent": { "type": "string" },
        "feedbackReceived": { "type": "string" },
        "dateFeedbackReceived": { "type": "string" },
        "feedbackLink": { "type": "string" },
        "feedbackRevision": { "type": "string" },
        "revision01Submitted": { "type": "string" },
        "dateRevision01Submitted": { "type": "string" },
        "manuscriptSubmission": { "type": "string" },
        "manuscriptSubmissionDate": { "type": "string" },
        "publisherSubmission": { "type": "string" },
        "publisherSubmissionDate": { "type": "string" },
        "typesetSubmission": { "type": "string" },
        "typesetSubmissionDate": { "type": "string" },
        "biographicalStatement": { "type": "string" },
        "bioText": { "type": "string" },
        "abstractText": { "type": "string" },
        "institutionalAffiliation": { "type": "string" },
        "followUpContacted": { "type": "string" },
        "dateFollowUpContacted": { "type": "string" },
        "decisionToProceed": { "type": "string" },
        "reasonIfNo": { "type": "string" },
        "imageListSubmitted": { "type": "string" },
        "imagesMeetQc": { "type": "string" },
        "indexingTermsSubmitted": { "type": "string" }
      },
      "required": [
        "id", "contributorId", "contributorName", "contributorEmail", "title", "folderUrl", "leadEditor",
        "initialAbstractSubmitted", "updatedAbstractSubmitted", "initialChapterSubmission", "initialChapterDate",
        "submittedWordCount", "followUpForInitialSubmission", "followUpDate", "feedbackSent", "dateFeedbackSent",
        "feedbackLink", "revision01Submitted", "dateRevision01Submitted", "followUpContacted", "dateFollowUpContacted",
        "decisionToProceed", "reasonIfNo", "imageListSubmitted", "imagesMeetQc", "indexingTermsSubmitted"
      ]
    },
    "User": {
      "title": "User",
      "description": "Represents an authenticated user.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "editor"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Stores chapter tracking data."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user roles and permissions."
    }
  }
}
